pragma solidity ^0.8.20;

contract CredentialRegistry {
    struct Credential {
        uint256 credentialId;
        address holder;
        address issuer;
        string credentialType;
        string metadataHash;
        bool revoked;
    }

    mapping(uint256 => Credential) public credentials;
    mapping(address => uint256[]) public holderCredentials;
    mapping(address => bool) public authorizedIssuers;
    uint256 public credentialCounter;

    event CredentialIssued(uint256 indexed credentialId, address indexed holder, address indexed issuer, string credentialType);
    event CredentialRevoked(uint256 indexed credentialId);

    function issueCredential(address _holder, string calldata _credentialType, string calldata _metadataHash) external {
        require(authorizedIssuers[msg.sender], "Only authorized issuers can grant credentials");
        require(_holder != address(0), "Invalid holder address");

        credentialCounter++;
        credentials[credentialCounter] = Credential({
            credentialId: credentialCounter,
            holder: _holder,
            issuer: msg.sender,
            credentialType: _credentialType,
            metadataHash: _metadataHash,
            revoked: false
        });

        holderCredentials[_holder].push(credentialCounter);
        emit CredentialIssued(credentialCounter, _holder, msg.sender, _credentialType);
    }

    function revokeCredential(uint256 _credentialId) external {
        Credential storage cred = credentials[_credentialId];
        require(msg.sender == cred.issuer, "Only the issuing authority can revoke");
        require(!cred.revoked, "Credential already revoked");

        cred.revoked = true;
        emit CredentialRevoked(_credentialId);
    }
}
